scans = {}   # активные задания (скан или образ)


def handle(req):
    rid = req.get("id")
    cmd = req.get("cmd")
    try:
        if cmd == "hello":
            send({"id": rid, "ev": "res", "data": {"version": VERSION, "euid": os.geteuid()}})
        elif cmd == "smart":
            send({"id": rid, "ev": "res", "data": cmd_smart(req)})
        elif cmd == "grant_read":
            send({"id": rid, "ev": "res", "data": cmd_grant(req)})
        elif cmd == "revoke_read":
            send({"id": rid, "ev": "res", "data": cmd_revoke(req)})
        elif cmd == "selftest":
            send({"id": rid, "ev": "res", "data": cmd_selftest(req)})
        elif cmd == "scan":
            if any(s.is_alive() for s in scans.values()):
                raise BadRequest("сканирование уже идёт")
            s = Scan(rid, req)
            scans[rid] = s
            s.start()
        elif cmd == "clone_check":
            chk = check_clone(req)
            chk["steps"] = clone_steps(chk, bool(req.get("verify", True)))
            chk["script"] = sfdisk_script(chk, bool(req.get("new_ids")))
            send({"id": rid, "ev": "res", "data": chk})
        elif cmd == "shrink_info":
            dev = req.get("src")
            if not isinstance(dev, str) or not WHOLE_DISK_RE.match(dev):
                raise BadRequest("нужен весь диск")
            dev = check_dev(dev)
            node = lsblk_node(dev)
            out = []
            for c in node.get("children") or []:
                fs = c.get("fstype") or ""
                size_sec = int(c["size"]) // SECTOR
                info = {"node": c["path"], "fs": fs, "size": size_sec, "min": None, "reason": ""}
                if fs in SHRINKERS and not mounts_of(c):
                    mn, why = fs_min_size(c["path"], fs)
                    if mn is not None:
                        info["min"] = shrink_floor(mn, size_sec)
                        info["used"] = mn
                    else:
                        info["reason"] = why
                elif fs in SHRINKERS:
                    info["reason"] = "примонтирован"
                else:
                    info["reason"] = "не уменьшается"
                out.append(info)
            send({"id": rid, "ev": "res", "data": {"parts": out, "staging": default_staging()}})
        elif cmd == "backup":
            if any(s.is_alive() for s in scans.values()):
                raise BadRequest("другая операция уже выполняется")
            j = Backup(rid, req)
            scans[rid] = j
            j.start()
        elif cmd == "backup_verify":
            folder, man = load_manifest(req.get("folder"))
            probs = verify_files(folder, man)
            send({"id": rid, "ev": "res", "data": {"problems": probs, "partitions": len(man["partitions"])}})
        elif cmd == "restore_check":
            chk = check_restore(req)
            chk["steps"] = ["Проверка резервной копии"] + clone_steps(chk, bool(req.get("verify", True)))
            chk["script"] = sfdisk_script(chk, bool(req.get("new_ids")))
            chk.pop("manifest", None)
            send({"id": rid, "ev": "res", "data": chk})
        elif cmd == "restore":
            if any(s.is_alive() for s in scans.values()):
                raise BadRequest("другая операция уже выполняется")
            j = Restore(rid, req)
            scans[rid] = j
            j.start()
        elif cmd == "clone":
            if any(s.is_alive() for s in scans.values()):
                raise BadRequest("другая операция уже выполняется")
            j = Clone(rid, req)
            scans[rid] = j
            j.start()
        elif cmd == "image":
            if any(s.is_alive() for s in scans.values()):
                raise BadRequest("другая операция уже выполняется")
            j = Image(rid, req)
            scans[rid] = j
            j.start()
        elif cmd in ("pause", "resume", "stop"):
            s = scans.get(req.get("target"))
            if s is None:
                raise BadRequest("нет такого сканирования")
            getattr(s, cmd)()
            send({"id": rid, "ev": "res", "data": {}})
        else:
            raise BadRequest("неизвестная команда")
    except BadRequest as e:
        send({"id": rid, "ev": "err", "msg": str(e)})
    except Exception as e:  # noqa: BLE001
        send({"id": rid, "ev": "err", "msg": f"внутренняя ошибка: {e}"})


def main():
    if os.geteuid() != 0:
        send({"id": 0, "ev": "err", "msg": "помощник должен работать от root"})
        return 2
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
            if not isinstance(req, dict):
                raise ValueError
        except ValueError:
            send({"id": 0, "ev": "err", "msg": "некорректный запрос"})
            continue
        handle(req)
    for s in scans.values():
        s.stop()
    for s in scans.values():     # дать ddrescue сохранить карту
        s.join(timeout=20)
    revoke_all()
    return 0


if __name__ == "__main__":
    sys.exit(main())
